# VectorFlow environment configuration
# Copy to .env and fill in your values:  cp env.sample .env

# --- Required -------------------------------------------------------------
# OpenAI API key used for embeddings and answers
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- Secrets (CHANGE these for anything reachable by other people) -------
# JWT signing secret, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=vectorflow-super-secret-key-change-in-production
# Shared secret the gateway uses to call the Python service:  openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-api-key

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=vectorflow_sql_db
POSTGRES_USER=vectorflow
POSTGRES_PASSWORD=vectorflow123
# Host port for connecting with psql/DB tools (5433 avoids clashing with a local PostgreSQL)
POSTGRES_HOST_PORT=5433

# --- Models (optional) ----------------------------------------------------
# Changing the embedding model/dimensions requires re-ingesting documents
# (or a new QDRANT_COLLECTION), because vectors from different models aren't comparable.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4o-mini

# --- Security (optional) --------------------------------------------------
# true = refuse to start with default secrets. Turn on for any public deployment.
SECURITY_STRICT=false
# Per-user limits (protect your OpenAI bill); login lockout is 10 failures / 15 min
RATE_LIMIT_ASK_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=60
# Set to false in production to hide the GraphQL schema
GRAPHQL_INTROSPECTION=true

# --- Misc (optional) ------------------------------------------------------
# Port for the web app. If you change it, add the same port to CORS_ALLOWED_ORIGINS.
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
GRAPHIQL_ENABLED=true
LOG_LEVEL=INFO
